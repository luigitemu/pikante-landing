---
import { sanity, urlFor } from '../lib/sanity';
import type { Image as SanityImage } from '@sanity/types';

type LifestyleDoc = {
  eyebrow: string;
  headlinePrefix: string;
  headlineEmphasis: string;
  tags: string[];
  backgroundImage: SanityImage & { alt: string };
};

const lifestyle = await sanity.fetch<LifestyleDoc>('*[_id == "lifestyle"][0]');
---

<section class="life reveal" id="vida">
  <div class="life-bg">
    <img src={urlFor(lifestyle.backgroundImage).width(2813).auto('format').url()} alt={lifestyle.backgroundImage.alt} loading="lazy" />
  </div>
  <div class="life-content">
    <span class="eyebrow">{lifestyle.eyebrow}</span>
    <h2>{lifestyle.headlinePrefix}<br/><em>{lifestyle.headlineEmphasis}</em></h2>
    <div class="tags">
      {lifestyle.tags?.map((tag) => <span>{tag}</span>)}
    </div>
  </div>
</section>
