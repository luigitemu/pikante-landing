---
import { Flame } from '@lucide/astro';
import { sanity } from '../lib/sanity';

type WhatIsDoc = {
  eyebrow: string;
  headlinePrefix: string;
  headlineEmphasis: string;
  intro: string;
  items: { title: string; description: string }[];
};

const whatIs = await sanity.fetch<WhatIsDoc>('*[_id == "whatIs"][0]');

const ICONS = [
  'flame',
  'M8 3h8l-1 4-2 13H11L9 7z|M10 9h4',
  'M13 2 4 14h6l-1 8 9-12h-6z',
  'M2 22l5-14 9 9z|M14 4l2 2M18 2v3M21 7l-2 .5M14 11l3-3',
];
---

<section class="what">
  <div class="container">
    <div class="section-head reveal">
      <div>
        <span class="eyebrow">{whatIs.eyebrow}</span>
        <h2>{whatIs.headlinePrefix}<br/><em>{whatIs.headlineEmphasis}</em></h2>
      </div>
      <p>{whatIs.intro}</p>
    </div>

    <div class="what-list">
      {whatIs.items?.map((item, i) => (
        <div class="what-item reveal" style={`transition-delay:${i * 0.05}s`}>
          <span class="what-n">{String(i + 1).padStart(2, '0')}</span>
          <div class="what-icon">
            {i === 0 ? (
              <Flame width={24} height={24} fill="currentColor" />
            ) : (
              <svg viewBox="0 0 24 24" fill={i === 2 ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                {(ICONS[i] ?? ICONS[ICONS.length - 1]).split('|').map((d) => <path d={d} />)}
              </svg>
            )}
          </div>
          <div class="what-content">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
