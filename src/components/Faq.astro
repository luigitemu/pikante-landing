---
import { sanity } from '../lib/sanity';
import { richTextToHtml } from '../lib/portableText';
import type { PortableTextBlock } from '@portabletext/types';

type FaqDoc = {
  eyebrow: string;
  headlinePrefix: string;
  headlineEmphasis: string;
  intro: string;
  items: { question: string; answer: PortableTextBlock[] }[];
};

const faq = await sanity.fetch<FaqDoc>('*[_id == "faq"][0]');
---

<section class="faq" id="faq">
  <div class="container">
    <div class="section-head reveal">
      <div>
        <span class="eyebrow">{faq.eyebrow}</span>
        <h2>{faq.headlinePrefix}<br/><em>{faq.headlineEmphasis}</em></h2>
      </div>
      <p>{faq.intro}</p>
    </div>
    <div class="faq-list reveal">
      {faq.items?.map((item, i) => (
        <div class="faq-item" data-open={i === 0 ? 'true' : undefined}>
          <button class="faq-q" aria-expanded={i === 0 ? 'true' : 'false'}>
            <span>{item.question}</span>
            <span class="plus"></span>
          </button>
          <div class="faq-a">
            <div class="faq-a-inner" set:html={richTextToHtml(item.answer)} />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.faq-q').forEach(btn => {
    btn.addEventListener('click', () => {
      const item = btn.closest('.faq-item');
      const isOpen = item?.getAttribute('data-open') === 'true';
      document.querySelectorAll('.faq-item').forEach(i => {
        i.removeAttribute('data-open');
        i.querySelector('.faq-q')?.setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) {
        item?.setAttribute('data-open', 'true');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
