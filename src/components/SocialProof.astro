---
import { sanity } from '../lib/sanity';

type SocialProofDoc = {
  eyebrow: string;
  headlinePrefix: string;
  headlineEmphasis: string;
  intro: string;
  stats: { value: string; label: string }[];
  reviews: { stars: number; quote: string; authorInitials: string; authorName: string; authorLocation: string }[];
};

const socialProof = await sanity.fetch<SocialProofDoc>('*[_id == "socialProof"][0]');
---

<section class="social">
  <div class="container">
    <div class="section-head reveal">
      <div>
        <span class="eyebrow">{socialProof.eyebrow}</span>
        <h2>{socialProof.headlinePrefix}<br/><em>{socialProof.headlineEmphasis}</em></h2>
      </div>
      <p>{socialProof.intro}</p>
    </div>

    <div class="stats reveal">
      {socialProof.stats?.map((stat) => (
        <div class="stat"><b>{stat.value}</b><span>{stat.label}</span></div>
      ))}
    </div>

    <div class="reviews">
      {socialProof.reviews?.map((review, i) => (
        <article class="review reveal" style={i > 0 ? `transition-delay:${i * 0.06}s` : undefined}>
          <div class="stars">{'★'.repeat(review.stars)}</div>
          <blockquote>"{review.quote}"</blockquote>
          <div class="author">
            <span class="avatar">{review.authorInitials}</span>
            <div>
              <b>{review.authorName}</b>
              <span>{review.authorLocation}</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
