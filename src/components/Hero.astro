---
import PrepVideo from './PrepVideo';
import { sanity } from '../lib/sanity';

type HeroDoc = {
  eyebrowLeft: string;
  eyebrowRight: string;
  headlinePrefix: string;
  headlineEmphasis: string;
  headlineMid: string;
  headlineStroke: string;
  ctaLabel: string;
  ctaHref: string;
  metrics: { value: string; label: string }[];
  prepVideo: {
    kicker?: string;
    tag?: string;
    headingPrefix?: string;
    headingEmphasis?: string;
    description?: string;
  };
};

const hero = await sanity.fetch<HeroDoc>('*[_id == "hero"][0]');
---

<header class="hero">
  <div class="container hero-inner">
    <div class="reveal">
      <div class="hero-eyebrow-row">
        <span class="dot"></span>
        <span>{hero.eyebrowLeft}</span>
        <span style="color:var(--text-4)">/</span>
        <span>{hero.eyebrowRight}</span>
      </div>
      <h1 class="h-display ">
        {hero.headlinePrefix} <em class="flame-letter">{hero.headlineEmphasis}</em><br/>
        {hero.headlineMid} <span class="stroke">{hero.headlineStroke}</span>.
      </h1>
      <div class="hero-ctas">
        <a class="btn btn-primary" href={hero.ctaHref}>
          {hero.ctaLabel}
          <span class="arrow">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M13 5l7 7-7 7"/>
            </svg>
          </span>
        </a>
      </div>
      <div class="hero-meta">
        {hero.metrics?.map((m) => (
          <div><b>{m.value}</b><span>{m.label}</span></div>
        ))}
      </div>
    </div>
    <PrepVideo
      client:visible
      kicker={hero.prepVideo?.kicker}
      tag={hero.prepVideo?.tag}
      headingPrefix={hero.prepVideo?.headingPrefix}
      headingEmphasis={hero.prepVideo?.headingEmphasis}
      description={hero.prepVideo?.description}
    />
  </div>
</header>
