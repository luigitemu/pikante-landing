---
import { sanity, urlFor } from '../lib/sanity';
import type { Image as SanityImage } from '@sanity/types';

type OfferDoc = {
  eyebrow: string;
  headlinePrefix: string;
  headlineEmphasis: string;
  intro: string;
  perks: string[];
  countdownHours: number;
  countdownMinutes: number;
  ctaLabel: string;
  ctaHref: string;
  image: SanityImage & { alt: string };
};

const offer = await sanity.fetch<OfferDoc>('*[_id == "offer"][0]');
---
<section class="offer">
  <div class="container">
    <div class="offer-card reveal">
      <div class="offer-inner">
        <div>
          <span class="eyebrow">{offer.eyebrow}</span>
          <h2>{offer.headlinePrefix}<br/><em>{offer.headlineEmphasis}</em></h2>
          <p class="lede">{offer.intro}</p>

          <div class="perks">
            {offer.perks?.map((perk) => (
              <div>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg>
                {perk}
              </div>
            ))}
          </div>

          <div class="countdown" aria-label="Tiempo restante de la oferta" data-hours={offer.countdownHours} data-minutes={offer.countdownMinutes}>
            <div class="cd-cell"><b id="cd-h">{String(offer.countdownHours).padStart(2, '0')}</b><span>Horas</span></div>
            <div class="cd-cell"><b id="cd-m">{String(offer.countdownMinutes).padStart(2, '0')}</b><span>Min</span></div>
            <div class="cd-cell"><b id="cd-s">00</b><span>Seg</span></div>
          </div>

          <a class="btn btn-primary" href={offer.ctaHref} style="padding:20px 30px">
            {offer.ctaLabel}
            <span class="arrow">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M13 5l7 7-7 7"/>
              </svg>
            </span>
          </a>
        </div>

        <div class="offer-photo">
          <img src={urlFor(offer.image).width(1024).auto('format').url()} alt={offer.image.alt} loading="lazy" />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const el = document.querySelector('.countdown') as HTMLElement | null;
  const hours = Number(el?.dataset.hours ?? 0);
  const minutes = Number(el?.dataset.minutes ?? 0);
  const target = Date.now() + (hours * 3600 + minutes * 60) * 1000;
  const cdH = document.getElementById('cd-h');
  const cdM = document.getElementById('cd-m');
  const cdS = document.getElementById('cd-s');
  function pad(n: number): string { return String(n).padStart(2, '0'); }
  setInterval(() => {
    const diff = Math.max(0, target - Date.now());
    if (cdH) cdH.textContent = pad(Math.floor(diff / 3600000));
    if (cdM) cdM.textContent = pad(Math.floor((diff % 3600000) / 60000));
    if (cdS) cdS.textContent = pad(Math.floor((diff % 60000) / 1000));
  }, 1000);
</script>
