---
import { sanity } from '../lib/sanity';

type StoresDoc = {
  eyebrow: string;
  headlinePrefix: string;
  headlineEmphasis: string;
  intro: string;
  cities: {
    city: string;
    dept: string;
    code: string;
    featured: boolean;
    places: { name: string; type: string }[];
  }[];
  ctaHeading: string;
  ctaSubtext?: string;
  ctaButtonLabel: string;
  ctaButtonHref: string;
};

const stores = await sanity.fetch<StoresDoc>('*[_id == "stores"][0]');
const cities = stores.cities ?? [];
const totalPlaces = cities.reduce((n, c) => n + (c.places?.length ?? 0), 0);
const updatedDate = new Date().toLocaleDateString('es-HN', { month: 'short', year: 'numeric' });

function slugify(s: string) {
  return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-');
}
---

<section class="stores" id="proveedores">
  <div class="container">

    <div class="section-head reveal">
      <div>
        <span class="eyebrow">{stores.eyebrow}</span>
        <h2>{stores.headlinePrefix}<br/><em>{stores.headlineEmphasis}</em></h2>
      </div>
      <p>{stores.intro}</p>
    </div>

    <div class="stores-block reveal">
      <div class="stores-block-head">
        <h3>Puntos de <em>venta</em></h3>
        <div class="meta">
          <span><b>{cities.length}</b> ciudades</span>
          <span>·</span>
          <span><b>{totalPlaces}</b> puntos activos</span>
          <span>·</span>
          <span>Actualizado · {updatedDate}</span>
        </div>
      </div>

      <div class="city-grid">
        {cities.map((c, i) => (
          <article
            class={`city-card reveal${c.featured ? ' is-featured' : ''} city-card--${slugify(c.city)}`}
            style={`transition-delay:${i * 0.06}s`}
          >
            <header class="city-card-head">
              <span class="city-code">/ {c.code}</span>
              <div class="city-name">
                <h4>{c.city}</h4>
                <span class="city-dept">{c.dept}</span>
              </div>
              <span class="city-count" aria-label={`${c.places.length} puntos`}>
                <b>{String(c.places.length).padStart(2, '0')}</b>
                <em>punto{c.places.length > 1 ? 's' : ''}</em>
              </span>
            </header>

            <ul class="city-places">
              {c.places.map((p) => (
                <li class="place">
                  <span class="place-pin" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 22s7-7.5 7-13a7 7 0 1 0-14 0c0 5.5 7 13 7 13z"/>
                      <circle cx="12" cy="9" r="2.4"/>
                    </svg>
                  </span>
                  <span class="place-body">
                    <b class="place-name">{p.name}</b>
                    <span class="place-type">{p.type}</span>
                  </span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>

    <div class="stores-cta reveal">
      <div class="stores-cta-text">
        <h4>{stores.ctaHeading}</h4>
        {stores.ctaSubtext && <p>{stores.ctaSubtext}</p>}
      </div>
      <a class="btn btn-primary" href={stores.ctaButtonHref} target="_blank" rel="noopener noreferrer">
        {stores.ctaButtonLabel}
        <span class="arrow">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 8h10M9 4l4 4-4 4"/>
          </svg>
        </span>
      </a>
    </div>

  </div>
</section>
