---
import { Flame } from '@lucide/astro';
import { sanity, urlFor } from '../lib/sanity';
import { richTextToHtml } from '../lib/portableText';
import type { Image as SanityImage } from '@sanity/types';
import type { PortableTextBlock } from '@portabletext/types';

const FlameSize = 20;

type ProductsDoc = {
  eyebrow: string;
  headlinePrefix: string;
  headlineEmphasis: string;
  intro: string;
  items: {
    name: string;
    tag?: string;
    description: PortableTextBlock[];
    image: SanityImage & { alt: string };
    heatLevel: number;
    price250: string;
    price570: string;
    price1L: string;
  }[];
};

const products = await sanity.fetch<ProductsDoc>('*[_id == "products"][0]');
---

<section class="products" id="sabores">
  <div class="container">
    <div class="section-head reveal">
      <div>
        <span class="eyebrow">{products.eyebrow}</span>
        <h2>{products.headlinePrefix}<br/><em>{products.headlineEmphasis}</em></h2>
      </div>
      <p>{products.intro}</p>
    </div>
    <div class="prod-grid">
      {products.items?.map((prod, i) => (
        <article class="prod reveal" style={i > 0 ? `transition-delay:${i * 0.07}s` : undefined}>
          <div class="prod-img">
            {prod.tag && <span class="prod-tag hot">{prod.tag}</span>}
            <img src={urlFor(prod.image).width(1024).auto('format').url()} alt={prod.image.alt} loading="lazy" />
          </div>
          <div class="prod-body">
            <span
              class="price"
              data-v250={`L ${prod.price250} · 250ml`}
              data-v570={`L ${prod.price570} · 570ml`}
              data-v1l={`L ${prod.price1L} · 1L`}
            >L {prod.price570} <span style="color:var(--text-4)">&middot; 570ml</span></span>
            <h3>{prod.name}</h3>
            <p set:html={richTextToHtml(prod.description)} />
            <div class="prod-variants">
              <button class="variant-pill" data-variant="v250">250ml</button>
              <button class="variant-pill active" data-variant="v570">570ml</button>
              <button class="variant-pill" data-variant="v1l">1 Litro</button>
            </div>
            <div class="prod-row2">
              <span class="chiles" aria-label={`Picante ${prod.heatLevel} de 5`}>
                {Array.from({ length: 5 }).map((_, n) => (
                  <Flame width={FlameSize} height={FlameSize} fill="currentColor" class={`text-(--fire) ${n >= prod.heatLevel ? 'opacity-20' : ''}`} />
                ))}
              </span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.prod').forEach((card) => {
    const pills = card.querySelectorAll<HTMLButtonElement>('.variant-pill');
    const priceEl = card.querySelector<HTMLElement>('.price');

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        pills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');

        const key = pill.dataset.variant as string;
        if (priceEl && priceEl.dataset[key]) {
          const [amount, size] = priceEl.dataset[key]!.split(' · ');
          priceEl.innerHTML = `${amount} <span style="color:var(--text-4)">&middot; ${size}</span>`;
        }
      });
    });
  });
</script>
