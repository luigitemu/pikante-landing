---
import { sanity, urlFor } from '../lib/sanity';
import type { Image as SanityImage } from '@sanity/types';

type HowToDoc = {
  eyebrow: string;
  headlinePrefix: string;
  headlineEmphasis: string;
  intro: string;
  steps: { stepLabel: string; title: string; description: string; image: SanityImage & { alt: string } }[];
};

const howTo = await sanity.fetch<HowToDoc>('*[_id == "howTo"][0]');
---

<section class="how" id="preparar">
  <div class="container">
    <div class="section-head reveal">
      <div>
        <span class="eyebrow">{howTo.eyebrow}</span>
        <h2>{howTo.headlinePrefix}<br/><em>{howTo.headlineEmphasis}</em></h2>
      </div>
      <p>{howTo.intro}</p>
    </div>
    <div class="steps">
      {howTo.steps?.map((step, i) => (
        <article class="step reveal" style={i > 0 ? `transition-delay:${i * 0.08}s` : undefined}>
          <div class="step-photo">
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <img src={urlFor(step.image).width(1024).auto('format').url()} alt={step.image.alt} loading="lazy" />
          </div>
          <div class="step-body">
            <span class="mono">{step.stepLabel}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
